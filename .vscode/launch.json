{
    "version": "0.2.0",
    "configurations": [
        

        {
            "name": "Python: FastAPI",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend"
        },
        {
            "name": "Flutter: Windows",
            "request": "launch",
            "type": "dart",
            "cwd": "${workspaceFolder}/frontend",
            "program": "lib/main.dart"
        }
    ],
    "compounds": [
        {
            "name": "Run Full Stack",
            "configurations": ["Python: FastAPI", "Flutter: Windows"]
        }
    ]
}